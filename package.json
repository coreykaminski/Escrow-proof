{
  "name": "proof-desk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:generate": "npm run generate -w @proofdesk/db",
    "cli": "tsx apps/api/src/cli.ts",
    "eval:spec": "tsx evals/spec-engine/run.ts",
    "eval:spec:score": "tsx evals/spec-engine/score.ts",
    "golden:base": "tsx evals/translation/build-base.ts",
    "golden:corrupt": "tsx evals/translation/build-corruptions.ts",
    "golden:build": "tsx evals/translation/build-golden.ts",
    "eval:translation": "tsx evals/translation/run.ts",
    "stripe:e2e": "tsx scripts/stripe-e2e.ts",
    "contracts:build": "cd contracts && forge build && cd .. && tsx scripts/gen-chain-abi.ts && biome format --write packages/chain/src/abi.ts",
    "contracts:test": "cd contracts && forge test",
    "chain:deploy": "cd contracts && forge script script/Deploy.s.sol --rpc-url \"$CHAIN_RPC_URL\" --private-key \"$DEPLOYER_PRIVATE_KEY\" --broadcast",
    "chain:e2e": "tsx scripts/chain-e2e.ts",
    "golden:code": "tsx evals/code/build-golden.ts",
    "eval:code": "tsx evals/code/run.ts",
    "golden:data": "tsx evals/data/build-golden.ts",
    "eval:data": "tsx evals/data/run.ts",
    "worker": "tsx apps/api/src/worker.ts",
    "start": "tsx apps/api/src/server.ts",
    "chain:deploy-anchor": "cd contracts && forge script script/DeployAnchor.s.sol --rpc-url \"$CHAIN_RPC_URL\" --private-key \"$DEPLOYER_PRIVATE_KEY\" --broadcast",
    "evals:publish": "tsx evals/shared/publish.ts && biome format --write apps/api/src/data/golden-results.json",
    "verify-proof": "tsx scripts/verify-proof.ts",
    "test:postgres": "TEST_DB=postgres vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
