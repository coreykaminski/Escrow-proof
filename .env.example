# Embedded Postgres persisted to a folder (default). Use postgres://... for Neon/Supabase/etc.
DATABASE_URL=pglite:./.data/dev
PORT=8787

# Spec Engine (Part 2). Without a key, the drafting endpoints return 503.
ANTHROPIC_API_KEY=
# Optional: model for drafting criteria (default claude-opus-5-5).
# SPEC_DRAFT_MODEL=claude-opus-5-5

# Card rail (Part 4). Use test-mode keys (sk_test_…) until legal sign-off.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (from `stripe listen` or the Dashboard webhook endpoint)
# PUBLIC_URL=http://localhost:8787  (base for Stripe onboarding return links)
# STRIPE_PUBLISHABLE_KEY=pk_test_...  (hosted card page /pay/…)
# STRIPE_EXTENDED_AUTH=on   only if Stripe has enabled extended authorization for your account

# Stablecoin rail (Part 7): ProofDeskJobs (ERC-8183) on Base. Proof Desk is only the evaluator.
# Deploy with: DEPLOYER_PRIVATE_KEY=0x… PAYMENT_TOKEN=0x036CbD53842c5426634e7929541eC2318f3dCF7e npm run chain:deploy
# CHAIN_RPC_URL=https://sepolia.base.org
# CHAIN_ID=84532
# JOBS_CONTRACT=0x...
# Keys, one per role (docs/security/evaluator-keys.md). Each role takes <ROLE>_KMS_KEY_ID (AWS KMS,
# key spec ECC_SECG_P256K1; AWS_REGION + default AWS credentials) or <ROLE>_PRIVATE_KEY (testnets
# only: on Base mainnet raw keys are refused and every role needs its own KMS key).
# EVALUATOR_PRIVATE_KEY=0x...   (decides jobs; a little ETH for gas)
# RELAYER_PRIVATE_KEY=0x...     (optional: pays gas to relay gasless funding; defaults to the evaluator)
# EVALUATOR_KMS_KEY_ID=arn:aws:kms:...  RELAYER_KMS_KEY_ID=...  AWS_REGION=us-east-1

# Reviewer payouts (Part 9): paid from the platform balance, so use its settlement currency.
# REVIEWER_PAYOUT_CURRENCY=cad
# REVIEWER_RATE_DECISION=800      (minor units per human decision)
# REVIEWER_RATE_DISPUTE=2000      (per dispute resolution)

# Ledger anchoring (Part 10): daily, the ledger's Merkle tree head is posted to LedgerAnchor on the same chain.
# Deploy with: ANCHORER=0x<anchor key address> npm run chain:deploy-anchor
# ANCHOR_CONTRACT=0x...
# ANCHOR_PRIVATE_KEY=0x...   (or ANCHOR_KMS_KEY_ID; off mainnet defaults to the evaluator key)
# ANCHOR_INTERVAL_H=24

# Observability: structured logs (json in production, text otherwise) and an alert webhook
# (Slack/Discord-compatible) for server errors, worker failures and a failed ledger check.
# LOG_LEVEL=info
# LOG_FORMAT=json
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
